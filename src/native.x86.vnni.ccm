  }

  /// Accumulate products of two signed words from a and b, modulo 2^32. Uses AVX-VNNI.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::avxvnni))
  [[nodiscard]] hint_inline hint_const hint_target("avxvnni")
  constexpr simd<std::int32_t, 4, Arch> dpwssd(simd<std::int32_t, 4, Arch> accumulator, simd<std::int16_t, 8, Arch> a, simd<std::int16_t, 8, Arch> b) noexcept {
