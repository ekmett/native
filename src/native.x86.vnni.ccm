      Arch.has(x86_feature::avx512vl))
  [[nodiscard]] hint_inline hint_const hint_target("avx512f,avx512vnni,avx512vl")
  constexpr simd<std::int32_t, 4, Arch> mask_dpbusds(simd<std::int32_t, 4, Arch> accumulator, predicate<4, Arch> mask, simd<std::uint8_t, 16, Arch> a, simd<std::int8_t, 16, Arch> b) noexcept {
    if consteval { return detail::x86_instruction_constant::dot<true>(accumulator, a, b, mask.to_bitset(), false); }
