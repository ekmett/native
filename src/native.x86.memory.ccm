  /// Gather all addressable lanes; N specifies the result lane count.
  template<int Scale, std::size_t N, isa<x86> Arch, class T>
    requires(Arch.has(x86_feature::avx2) && (Scale == 1 || Scale == 2 || Scale == 4 || Scale == 8) && N == 4 && (std::same_as<T, std::int32_t> || std::same_as<T, std::uint32_t>))
  native_nodiscard native_inline native_target("avx2")
  constexpr simd<T, 4, Arch> vpgatherdd(T const * base, simd<std::int32_t, 4, Arch> indices) noexcept {
    if consteval {
