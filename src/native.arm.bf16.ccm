  }

  /// Constant-evaluation-only form when the instruction feature is absent.
  template<isa<arm> Arch>
    requires(!Arch.has(polyfill) && requires { sizeof(simd<float, 4, Arch>); } && requires { sizeof(simd<bf16, 8, Arch>); } && !(Arch.has(arm_feature::neon_bf16)))
  [[nodiscard]] consteval
  simd<float, 4, Arch> bfmlalt(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 8, Arch> b) noexcept {
    return detail::bfmlal_value<true,-1>(acc,a,b);
  }

  /// Evaluate runtime operands with explicit software-emulation permission.
  template<isa<arm> Arch>
    requires(Arch.has(polyfill) && requires { sizeof(simd<float, 4, Arch>); } && requires { sizeof(simd<bf16, 8, Arch>); } && !(Arch.has(arm_feature::neon_bf16)))
  [[nodiscard]] constexpr
  simd<float, 4, Arch> bfmlalt(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 8, Arch> b) noexcept {
    return detail::bfmlal_value<true,-1>(acc,a,b, detail::arm_float_control::current());
  }

  /// Fused multiply-add of the odd lanes of a with b[Lane] shared by all output lanes.
  template<isa<arm> Arch, unsigned Lane>
    requires(Arch.has(arm_feature::neon_bf16) && Lane < 4)
  [[nodiscard]] hint_inline hint_target("bf16")
  constexpr simd<float, 4, Arch> bfmlalt_lane(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 4, Arch> b) noexcept {
    if consteval { return detail::bfmlal_value<true,Lane>(acc,a,b); } else {
      auto result = detail::arm_bf16::bfmlalt_lane<Arch, Lane>(acc.to_native(), a.to_native(), __builtin_bit_cast(bfloat16x4_t, b.to_native()));
      return simd<float, 4, Arch>::from_native(result);
    }
  }

  /// Constant-evaluation-only form when the instruction feature is absent.
  template<isa<arm> Arch, unsigned Lane>
    requires(!Arch.has(polyfill) && requires { sizeof(simd<float, 4, Arch>); } && requires { sizeof(simd<bf16, 8, Arch>); } && requires { sizeof(simd<bf16, 4, Arch>); } && !(Arch.has(arm_feature::neon_bf16)) && Lane < 4)
  [[nodiscard]] consteval
  simd<float, 4, Arch> bfmlalt_lane(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 4, Arch> b) noexcept {
    return detail::bfmlal_value<true,Lane>(acc,a,b);
  }

  /// Evaluate runtime operands with explicit software-emulation permission.
  template<isa<arm> Arch, unsigned Lane>
    requires(Arch.has(polyfill) && requires { sizeof(simd<float, 4, Arch>); } && requires { sizeof(simd<bf16, 8, Arch>); } && requires { sizeof(simd<bf16, 4, Arch>); } && !(Arch.has(arm_feature::neon_bf16)) && Lane < 4)
  [[nodiscard]] constexpr
  simd<float, 4, Arch> bfmlalt_lane(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 4, Arch> b) noexcept {
    return detail::bfmlal_value<true,Lane>(acc,a,b, detail::arm_float_control::current());
  }

  /// Fused multiply-add of the odd lanes of a with b[Lane] shared by all output lanes.
  template<isa<arm> Arch, unsigned Lane>
    requires(Arch.has(arm_feature::neon_bf16) && Lane < 8)
  [[nodiscard]] hint_inline hint_target("bf16")
  constexpr simd<float, 4, Arch> bfmlalt_lane(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 8, Arch> b) noexcept {
    if consteval { return detail::bfmlal_value<true,Lane>(acc,a,b); } else {
      auto result = detail::arm_bf16::bfmlalt_lane<Arch, Lane>(acc.to_native(), a.to_native(), b.to_native());
      return simd<float, 4, Arch>::from_native(result);
    }
  }

  /// Constant-evaluation-only form when the instruction feature is absent.
  template<isa<arm> Arch, unsigned Lane>
    requires(!Arch.has(polyfill) && requires { sizeof(simd<float, 4, Arch>); } && requires { sizeof(simd<bf16, 8, Arch>); } && !(Arch.has(arm_feature::neon_bf16)) && Lane < 8)
  [[nodiscard]] consteval
  simd<float, 4, Arch> bfmlalt_lane(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 8, Arch> b) noexcept {
    return detail::bfmlal_value<true,Lane>(acc,a,b);
  }

  /// Evaluate runtime operands with explicit software-emulation permission.
  template<isa<arm> Arch, unsigned Lane>
    requires(Arch.has(polyfill) && requires { sizeof(simd<float, 4, Arch>); } && requires { sizeof(simd<bf16, 8, Arch>); } && !(Arch.has(arm_feature::neon_bf16)) && Lane < 8)
  [[nodiscard]] constexpr
  simd<float, 4, Arch> bfmlalt_lane(simd<float, 4, Arch> acc, simd<bf16, 8, Arch> a, simd<bf16, 8, Arch> b) noexcept {
    return detail::bfmlal_value<true,Lane>(acc,a,b, detail::arm_float_control::current());
  }

  // Exact deduction rejects unrelated vectors and invalid immediates before
  // Clang's lax vector conversions can select an overload for another shape.
  /// \cond
  template<isa<arm> Arch, class R, class A, class B> void bfdot(R, A, B) = delete;
  template<isa<arm> Arch, class R, class A, class B> void bfmmla(R, A, B) = delete;
  template<isa<arm> Arch, class R, class A, class B> void bfmlalb(R, A, B) = delete;
  template<isa<arm> Arch, class R, class A, class B> void bfmlalt(R, A, B) = delete;
  template<isa<arm> Arch, unsigned Lane, class R, class A, class B> void bfdot_lane(R, A, B) = delete;
  template<isa<arm> Arch, unsigned Lane, class R, class A, class B> void bfmlalb_lane(R, A, B) = delete;
  template<isa<arm> Arch, unsigned Lane, class R, class A, class B> void bfmlalt_lane(R, A, B) = delete;

  /// \endcond
  /// \}
}
#endif

