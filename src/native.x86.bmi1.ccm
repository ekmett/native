module;
#include "native/isa_import.h"
#include "native/x86/bmi1.h"
#include "native/x86/bmi1_defaults.h"
export module native.x86.bmi1;
export import native.x86.features;
export namespace native {
  /// \addtogroup x86_bmi1
  /// \{

  /// Re-export ANDN; see the \ref x86_bmi1 group for both operand widths.
  using ::native::andn;
  /// Re-export BEXTR; see the \ref x86_bmi1 group for packed and separate controls.
  using ::native::bextr;
  /// Re-export BLSI; see the \ref x86_bmi1 group for both operand widths.
  using ::native::blsi;
  /// Re-export BLSMSK; see the \ref x86_bmi1 group for both operand widths.
  using ::native::blsmsk;
  /// Re-export BLSR; see the \ref x86_bmi1 group for both operand widths.
  using ::native::blsr;
  /// Re-export TZCNT; see the \ref x86_bmi1 group for all three operand widths.
  using ::native::tzcnt;
  /// \}
}
