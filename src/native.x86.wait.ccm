module;
#include "native/isa_import.h"
#include <cstdint>
#include <x86intrin.h>
#include "native/attributes.h"
#include "native/targets.h"

export module native.x86.wait;
export import native.x86.features;

export namespace native {
  /// \defgroup x86_mwaitx MWAITX
  /// \ingroup wait
  /// MONITORX and MWAITX require x86_feature::mwaitx, reported by extended
  /// CPUID leaf 0x80000001 ECX bit 29. No vector-state feature is required.

  /// \defgroup x86_waitpkg WAITPKG
  /// \ingroup wait
  /// UMONITOR, UMWAIT and TPAUSE require x86_feature::waitpkg, reported by
  /// CPUID leaf 7 subleaf 0 ECX bit 5. No vector-state feature is required.

  /// \defgroup wait Waiting
  /// \{

  /// \brief some way to wait for a value to change
  /// \tparam T type to check
  template <typename T>
  concept waiter = requires (volatile void * p, std::uint32_t t) {
    bool(T::supported);
    T::monitor(p);
    T::mwait(t);
  };

  /// \brief Wait until a predicate holds about a given memory location
  /// \param p pointer to data. activity on its cache line will wake us up
  /// \param f predicate to check about the pointer
  ///
  /// \pre W::supported is true. The predicate provides any required atomic
  /// synchronization; volatile access alone is not inter-thread synchronization.
  /// Wakeups may be spurious, so the predicate is checked again after monitoring.
  /// \post f(p)
  /// \snippet api.cc capabilities
  template <waiter W> native_flatten
  void wait_until(volatile auto * p, auto f)
    noexcept(noexcept(!f(p)) && noexcept(W::monitor(p)) && noexcept(W::mwait(0))) native_blocking {
    [[assume(W::supported)]];
    while (!f(p)) {
      W::monitor(p);
      if (!f(p))
        W::mwait(0);
    }
  }

  /// \ref waiter using the MONITORX/MWAITX instruction feature
  struct mwaitx {
    using timer_t = std::uint64_t;
    /// \ingroup x86_mwaitx
    /// Arm MONITORX for p; call only when supported is true.
    [[gnu::target("mwaitx")]] static void monitor(volatile void * p) noexcept;
    /// \ingroup x86_mwaitx
    /// Issue MWAITX with the supplied timer operand; monitor must already be armed.
    [[gnu::target("mwaitx")]] static void mwait(std::uint32_t timer = 0) noexcept native_blocking;
    /// \hideinitializer \hideinlinesource
    static const bool supported;
  };


  /// \ref waiter using the WAITPKG instruction feature
  struct umwait {
    using timer_t = std::uint64_t;
    /// \ingroup x86_waitpkg
    /// Arm UMONITOR for p; call only when supported is true.
    [[gnu::target("waitpkg")]] static void monitor(volatile void * p) noexcept;
    /// \ingroup x86_waitpkg
    /// Issue UMWAIT with this absolute deadline operand; return the intrinsic status.
    [[gnu::target("waitpkg")]] static std::uint8_t mwait(std::uint64_t timer = 0) noexcept native_blocking;
    /// \hideinlinesource
    static const bool supported;
  };

  /// Wait until an absolute 64-bit TSC deadline without arming a monitor.
  /// Control 0 permits C0.2; Control 1 requests C0.1. The OS may limit the wait.
  /// Returns the intrinsic carry status; no memory ordering is promised.
  /// Call only after admitting WAITPKG on the executing CPU.
  template<isa<x86> Arch = NATIVE_BASELINE, unsigned Control = 1>
    requires(Arch.has(x86_feature::waitpkg) && Control < 2)
  native_inline native_artificial native_target("waitpkg")
  std::uint8_t tpause(std::uint64_t deadline) noexcept native_blocking {
    return __builtin_ia32_tpause(Control, std::uint32_t(deadline >> 32),
      std::uint32_t(deadline));
  }

  /// A universally supported x86 spin waiter using PAUSE; monitor is a no-op.
  struct spin {
    using timer_t = std::uint64_t;
    /// Ignore the address; PAUSE waiting does not arm a hardware monitor.
    native_inline native_artificial static void monitor(volatile void *) noexcept {}
    /// Issue one PAUSE, ignoring the timer; no sleep duration or memory ordering is promised.
    native_inline native_artificial static void mwait(std::uint32_t = 0) noexcept native_blocking { _mm_pause(); }
    /// \hideinlinesource
    inline static constinit bool supported = true;
  };

  /// \brief finds an appropriate waiter for the current CPU
  /// Prefer MWAITX, then WAITPKG, otherwise PAUSE. Invoke k once with that type.
  /// Runtime detection occurs here, not in a SIMD arithmetic operation.
  /// Usage:
  /// \code{.cpp}
  ///   with_waiter([&]<waiter W> { wait_until<W>(p, predicate); });
  /// \endcode
  /// invokes \p k with a waiter as a template parameter.
  auto with_waiter(auto k)
    noexcept(noexcept(k.template operator()<mwaitx>()) &&
      noexcept(k.template operator()<umwait>()) && noexcept(k.template operator()<spin>())) {
    if (mwaitx::supported) return k.template operator()<mwaitx>();
    else if (umwait::supported) return k.template operator()<umwait>();
    else return k.template operator()<spin>();
  }

  /// \}
}

namespace native {
  // Out-of-line module-owned leaves avoid exposing the intrinsic headers'
  // TU-local inline functions through a BMI, and preserve baseline callers.
  [[gnu::target("mwaitx")]] void mwaitx::monitor(volatile void * p) noexcept {
    _mm_monitorx(const_cast<void *>(p), 0, 0);
  }
  [[gnu::target("mwaitx")]] void mwaitx::mwait(std::uint32_t timer) noexcept native_blocking {
    _mm_mwaitx(0, 0, timer);
  }
  [[gnu::target("waitpkg")]] void umwait::monitor(volatile void * p) noexcept {
    _umonitor(const_cast<void *>(p));
  }
  [[gnu::target("waitpkg")]] std::uint8_t umwait::mwait(std::uint64_t timer) noexcept native_blocking {
    return _umwait(1, timer);
  }

  namespace {
    // Share the common observer and admission rules, including leaf validity.
    // Waiting needs no vector state or unrelated SIMD instruction features.
    const auto wait_capabilities = observe_x86_capabilities();
  }
  const bool mwaitx::supported = classify_isa(wait_capabilities, x86_feature::mwaitx).admitted();
  const bool umwait::supported = classify_isa(wait_capabilities, x86_feature::waitpkg).admitted();
}
