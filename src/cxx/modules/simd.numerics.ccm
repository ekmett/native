export module simd.numerics;
export import simd.types;

export namespace simd {

/// \brief Two-byte fp16 storage with environment-independent binary32 RNE conversion.
struct fp16 {
private:
  // Round binary32 to binary16, ties to even, independently of the FP controls.
  // Raw native-half projections below remain representation copies.
  static constexpr uint16_t encode(float value) noexcept {
    auto word = std::bit_cast<uint32_t>(value);
    auto sign = (word >> 16) & 0x8000u;
    auto a = word & 0x7fffffffu;
    if (a >= 0x7f800000u)
      return uint16_t(sign | 0x7c00u | (a == 0x7f800000u ? 0u : 0x200u | ((a >> 13) & 0x3ffu)));
    if (a >= 0x47800000u) return uint16_t(sign | 0x7c00u);
    if (a >= 0x38800000u)
      return uint16_t(sign | (((a + 0xfffu + ((a >> 13) & 1u)) >> 13) - 0x1c000u));
    if (a < 0x33000000u) return uint16_t(sign);
    auto shift = 126u - (a >> 23);
    auto significand = (a & 0x7fffffu) | 0x800000u;
    auto result = significand >> shift;
    auto remainder = significand & ((1u << shift) - 1u);
    auto half = 1u << (shift - 1u);
    result += remainder > half || (remainder == half && (result & 1u));
    return uint16_t(sign | result);
  }
  static constexpr float decode(uint16_t word) noexcept {
    auto sign = uint32_t(word & 0x8000u) << 16;
    auto exponent = (word >> 10) & 31u;
    auto fraction = uint32_t(word & 0x3ffu);
    uint32_t result;
    if (exponent == 0) {
      if (fraction == 0) return std::bit_cast<float>(sign);
      auto shift = unsigned(std::countl_zero(fraction)) - 21u;
      result = ((113u - shift) << 23) | (((fraction << shift) & 0x3ffu) << 13);
    } else if (exponent == 31) {
      result = 0x7f800000u | (fraction << 13) | (fraction ? 0x400000u : 0u);
    } else result = ((exponent + 112u) << 23) | (fraction << 13);
    return std::bit_cast<float>(sign | result);
  }
public:
  using underlying_type = _Float16;

  _Float16 content;

  simd_inline simd_artificial
  constexpr fp16() noexcept = default;

  simd_inline simd_artificial
  constexpr fp16(simd_noescape fp16 const &) noexcept = default;

  simd_inline simd_artificial
  constexpr fp16(simd_noescape fp16 &&) noexcept = default;

  simd_inline simd_artificial
  constexpr fp16(float value) noexcept : content(std::bit_cast<_Float16>(encode(value))) {}

  simd_inline simd_artificial
  constexpr fp16(_Float16 content) noexcept : content(content) {}

  simd_nodiscard simd_inline simd_artificial
  constexpr operator float (this fp16 self) noexcept { return decode(self.to_bits()); }

  simd_nodiscard simd_inline simd_artificial
  constexpr operator _Float16 (this fp16 self) noexcept { return self.content; }

  simd_reinitializes simd_inline simd_artificial
  constexpr fp16 & operator = (simd_noescape fp16 const &) noexcept
  simd_lifetimebound = default;

  simd_reinitializes simd_inline simd_artificial
  constexpr fp16 & operator = (simd_noescape fp16 &&) noexcept
  simd_lifetimebound = default;

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator == (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) == static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator != (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) != static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr std::partial_ordering operator <=> (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) <=> static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator < (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) < static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator <= (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) <= static_cast<float>(y);
  }
  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator > (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) > static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator >= (fp16 x, fp16 y) noexcept {
    return static_cast<float>(x) >= static_cast<float>(y);
  }

  simd_inline simd_artificial
  friend constexpr void swap(
    simd_noescape fp16 & x,
    simd_noescape fp16 & y
  ) noexcept {
    using std::swap;
    swap(x.content,y.content);
  }

  simd_inline simd_artificial simd_const
  static constexpr fp16 from_bits(uint16_t data) noexcept {
    return std::bit_cast<fp16>(data);
  }

  simd_nodiscard simd_inline simd_const
  constexpr uint16_t to_bits(this fp16 self) noexcept {
    return std::bit_cast<uint16_t>(self.content);
  }

};

simd_nodiscard simd_inline simd_artificial simd_const
constexpr fp16 operator""_fp16(long double v) noexcept {
  return fp16(static_cast<float>(v));
}

} // namespace simd

export namespace std {
  using ::std::numeric_limits;
  simd_nodiscard simd_artificial simd_inline simd_const
  constexpr bool isnan(simd::fp16 x) noexcept {
    // Sign doesn't matter, frac not zero (infinity)
    return (x.to_bits() & 0x7FFF) > 0x7c00;
  }

  template <>
  class numeric_limits<simd::fp16> {
  public:
    static constexpr bool is_specialized = true;
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 min() noexcept {
      return simd::fp16::from_bits(0x0400);
    }
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 max() noexcept {
      return simd::fp16::from_bits(0x7BFF);
    }
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 lowest() noexcept {
      return simd::fp16::from_bits(0xFBFF);
    }
    static constexpr int digits = 11;
    static constexpr int digits10 = 3;
    static constexpr int max_digits10 = 5;
    static constexpr bool is_signed = true;
    static constexpr bool is_integer = false;
    static constexpr bool is_exact = false;
    static constexpr int radix = 2;
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 epsilon() noexcept {
      return simd::fp16::from_bits(0x1400);
    }
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 round_error() noexcept {
      return simd::fp16::from_bits(0x3800);
    }
    static constexpr int min_exponent = -13;
    static constexpr int min_exponent10 = -4;
    static constexpr int max_exponent = 16;
    static constexpr int max_exponent10 = 4;
    static constexpr bool has_infinity = true;
    static constexpr bool has_quiet_NaN = true;
    static constexpr bool has_signaling_NaN = true;
    [[deprecated("std::float_denorm_style is deprecated since C++23")]]
    static constexpr float_denorm_style has_denorm = denorm_present;
    [[deprecated("numeric_limits::has_denorm_loss is deprecated since C++23")]]
    static constexpr bool has_denorm_loss = false;
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 infinity() noexcept {
      return simd::fp16::from_bits(0x7C00);
    }
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 quiet_NaN() noexcept {
      return simd::fp16::from_bits(0x7FFF);
    }
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 signaling_NaN() noexcept {
      return simd::fp16::from_bits(0x7DFF);
    }
    simd_inline simd_artificial simd_const
    static constexpr simd::fp16 denorm_min() noexcept {
      return simd::fp16::from_bits(1);
    }
    static constexpr bool is_iec559 = false;
    static constexpr bool is_bounded = true;
    static constexpr bool is_modulo = false;
    static constexpr bool traps = false;
    static constexpr bool tinyness_before = false;
    static constexpr float_round_style round_style = round_to_nearest;
  };



} // namespace std


export namespace simd {

/// \brief Two-byte bf16 storage with environment-independent binary32 RNE conversion.
struct bf16 {
private:
  // Conversion is integer RNE, including subnormals, under every FP environment.
  static constexpr uint16_t encode(float value) noexcept {
    auto word = std::bit_cast<uint32_t>(value);
    if ((word & 0x7fffffffu) > 0x7f800000u)
      return uint16_t((word >> 16) | 0x40u);
    return uint16_t((word + 0x7fffu + ((word >> 16) & 1u)) >> 16);
  }
  static constexpr float decode(uint16_t word) noexcept {
    auto result = uint32_t(word) << 16;
    if ((word & 0x7fffu) > 0x7f80u) result |= 0x400000u;
    return std::bit_cast<float>(result);
  }
public:
  using underlying_type = __bf16;

  __bf16 content;

  simd_inline simd_artificial constexpr
  bf16() noexcept = default;

  simd_inline simd_artificial constexpr
  bf16(float f) noexcept : content(std::bit_cast<__bf16>(encode(f))) {}

  simd_inline simd_artificial constexpr
  bf16(__bf16 f) noexcept : content(f) {}

  simd_inline simd_artificial constexpr
  bf16(simd_noescape bf16 const &) noexcept = default;

  simd_inline simd_artificial constexpr
  bf16(simd_noescape bf16 &&) noexcept = default;

  simd_nodiscard simd_inline simd_artificial simd_const constexpr
  operator __bf16 (this bf16 self) noexcept { return self.content; }

  simd_nodiscard simd_inline simd_artificial simd_const constexpr
  operator float (this bf16 self) noexcept { return decode(self.to_bits()); }

  simd_reinitializes simd_inline simd_artificial constexpr
  bf16 & operator = (simd_noescape bf16 const &) noexcept
  simd_lifetimebound = default;

  simd_reinitializes simd_inline simd_artificial constexpr
  bf16 & operator = (simd_noescape bf16 &&) noexcept
  simd_lifetimebound = default;

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator == (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) == static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr std::partial_ordering operator <=> (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) <=> static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator != (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) != static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator < (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) < static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator > (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) > static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator <= (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) <= static_cast<float>(y);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  friend constexpr bool operator >= (bf16 x, bf16 y) noexcept {
    return static_cast<float>(x) >= static_cast<float>(y);
  }

  simd_inline simd_artificial
  friend constexpr void swap(
    simd_noescape bf16 & x,
    simd_noescape bf16 & y
  ) noexcept {
    using std::swap;
    swap(x.content,y.content);
  }

  simd_nodiscard simd_inline simd_artificial simd_const
  static constexpr bf16 from_bits(uint16_t data) noexcept {
    return std::bit_cast<bf16>(data);
  }

  simd_nodiscard simd_inline simd_const
  constexpr uint16_t to_bits(this bf16 self) noexcept {
    return std::bit_cast<uint16_t>(self.content);
  }
};

simd_nodiscard simd_inline simd_artificial
constexpr bf16 operator""_bf16(long double v) noexcept {
  return bf16(static_cast<float>(v));
}

simd_nodiscard simd_inline simd_artificial simd_const
constexpr bf16 fast_to_bf16(float f) noexcept {
  if consteval {
    return f;
  } else {
    return std::bit_cast<bf16>(static_cast<uint16_t>(std::bit_cast<uint32_t>(f)>>16));
  }
}

simd_nodiscard simd_inline simd_artificial simd_const
constexpr bf16 fast_to_bf16(bf16 f) noexcept {
  return f;
}

} // namespace simd

export namespace std {
  using ::std::numeric_limits;
  simd_nodiscard simd_artificial simd_inline simd_const
  constexpr bool isnan(simd::bf16 x) noexcept {
    // Exponent maxed out and fraction non-zero indicates NaN
    return (x.to_bits() & 0x7FFF) > 0x7F80;
  }

  template <> class numeric_limits<simd::bf16> {
  public:
    static constexpr bool is_specialized = true;
    simd_nodiscard simd_inline simd_artificial simd_const
