/// \brief Scalar half storage, numeric limits and legacy scalar predicates.
module;
#include <bit>
#include <cmath>
#include <compare>
#include <concepts>
#include <cstddef>
#include <cstdint>
#include <limits>
#include <type_traits>
#include <utility>
#include "simd/attributes.h"
