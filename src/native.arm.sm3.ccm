module;
#include "native/isa_import.h"
#include "native/arm/sm3_constant.h"
#include "native/arm/sm3.h"
#include "native/targets.h"
export module native.arm.sm3;
export import native.arm.features;
export import native.simd;
#if NATIVE_HOST_NEON || defined(NATIVE_DOXYGEN)
export namespace native {
  /// \defgroup arm_sm3 SM3 instructions
  /// Individual Advanced SIMD operations on four native-order uint32_t words.
  /// Runtime calls require the named instruction feature; the compiler's "sm4"
  /// target enables both SM3 and SM4. Admit target_features<arm>("sm4") before
  /// entering its compiled leaf. These operations do not modify FPCR, FPSR or NZCV.
  /// Feature-absent overloads are immediate-only and require NEON vector storage.
  /// \{

  /// Rotate and add the lane-three inputs; return SS1 in lane three and zero elsewhere.
  template<isa<arm> Arch>
    requires(Arch.has(arm_feature::sm3))
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3ss1(simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b,
    simd<std::uint32_t, 4, Arch> c) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3ss1(a, b, c);
    } else {
      auto result = detail::arm_sm3::sm3ss1<Arch>(__builtin_bit_cast(uint32x4_t, a.to_native()),
        __builtin_bit_cast(uint32x4_t, b.to_native()),
        __builtin_bit_cast(uint32x4_t, c.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch>
    requires(!Arch.has(arm_feature::sm3) && requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3ss1(simd<std::uint32_t, 4, Arch> a,
    simd<std::uint32_t, 4, Arch> b, simd<std::uint32_t, 4, Arch> c) noexcept {
    return detail::arm_sm3_constant::sm3ss1(a, b, c);
  }

  /// Advance the reversed ABCD state by one early SM3 round using words[Lane].
  /// Lane must be in [0, 3]; lane three holds A or E in the state and SS1 in ss1.
  template<isa<arm> Arch, int Lane>
    requires(Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4)
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3tt1a(simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3tt1a<Lane>(state, ss1, words);
    } else {
      auto result =
        detail::arm_sm3::sm3tt1a<Arch, Lane>(__builtin_bit_cast(uint32x4_t, state.to_native()),
          __builtin_bit_cast(uint32x4_t, ss1.to_native()),
          __builtin_bit_cast(uint32x4_t, words.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch, int Lane>
    requires(!Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4 &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3tt1a(
    simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    return detail::arm_sm3_constant::sm3tt1a<Lane>(state, ss1, words);
  }

  /// Advance the reversed ABCD state by one late SM3 round using words[Lane].
  /// Lane must be in [0, 3]; lane three holds A or E in the state and SS1 in ss1.
  template<isa<arm> Arch, int Lane>
    requires(Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4)
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3tt1b(simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3tt1b<Lane>(state, ss1, words);
    } else {
      auto result =
        detail::arm_sm3::sm3tt1b<Arch, Lane>(__builtin_bit_cast(uint32x4_t, state.to_native()),
          __builtin_bit_cast(uint32x4_t, ss1.to_native()),
          __builtin_bit_cast(uint32x4_t, words.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch, int Lane>
    requires(!Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4 &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3tt1b(
    simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    return detail::arm_sm3_constant::sm3tt1b<Lane>(state, ss1, words);
  }

  /// Advance the reversed EFGH state by one early SM3 round using words[Lane].
  /// Lane must be in [0, 3]; lane three holds A or E in the state and SS1 in ss1.
  template<isa<arm> Arch, int Lane>
    requires(Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4)
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3tt2a(simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3tt2a<Lane>(state, ss1, words);
    } else {
      auto result =
        detail::arm_sm3::sm3tt2a<Arch, Lane>(__builtin_bit_cast(uint32x4_t, state.to_native()),
          __builtin_bit_cast(uint32x4_t, ss1.to_native()),
          __builtin_bit_cast(uint32x4_t, words.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch, int Lane>
    requires(!Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4 &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3tt2a(
    simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    return detail::arm_sm3_constant::sm3tt2a<Lane>(state, ss1, words);
  }

  /// Advance the reversed EFGH state by one late SM3 round using words[Lane].
  /// Lane must be in [0, 3]; lane three holds A or E in the state and SS1 in ss1.
  template<isa<arm> Arch, int Lane>
    requires(Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4)
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3tt2b(simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3tt2b<Lane>(state, ss1, words);
    } else {
      auto result =
        detail::arm_sm3::sm3tt2b<Arch, Lane>(__builtin_bit_cast(uint32x4_t, state.to_native()),
          __builtin_bit_cast(uint32x4_t, ss1.to_native()),
          __builtin_bit_cast(uint32x4_t, words.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch, int Lane>
    requires(!Arch.has(arm_feature::sm3) && Lane >= 0 && Lane < 4 &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3tt2b(
    simd<std::uint32_t, 4, Arch> state, simd<std::uint32_t, 4, Arch> ss1,
    simd<std::uint32_t, 4, Arch> words) noexcept {
    return detail::arm_sm3_constant::sm3tt2b<Lane>(state, ss1, words);
  }

  /// Compute the first four-word SM3 message-schedule update, including lane-zero feedback.
  template<isa<arm> Arch>
    requires(Arch.has(arm_feature::sm3))
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3partw1(simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b,
    simd<std::uint32_t, 4, Arch> c) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3partw1(a, b, c);
    } else {
      auto result = detail::arm_sm3::sm3partw1<Arch>(__builtin_bit_cast(uint32x4_t, a.to_native()),
        __builtin_bit_cast(uint32x4_t, b.to_native()),
        __builtin_bit_cast(uint32x4_t, c.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch>
    requires(!Arch.has(arm_feature::sm3) && requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3partw1(simd<std::uint32_t, 4, Arch> a,
    simd<std::uint32_t, 4, Arch> b, simd<std::uint32_t, 4, Arch> c) noexcept {
    return detail::arm_sm3_constant::sm3partw1(a, b, c);
  }

  /// Finish the four-word SM3 schedule update with the remaining XOR and rotation terms.
  template<isa<arm> Arch>
    requires(Arch.has(arm_feature::sm3))
  native_nodiscard native_inline native_const
  native_target("sm4") constexpr simd<std::uint32_t, 4, Arch>
  sm3partw2(simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b,
    simd<std::uint32_t, 4, Arch> c) noexcept {
    if consteval {
      return detail::arm_sm3_constant::sm3partw2(a, b, c);
    } else {
      auto result = detail::arm_sm3::sm3partw2<Arch>(__builtin_bit_cast(uint32x4_t, a.to_native()),
        __builtin_bit_cast(uint32x4_t, b.to_native()),
        __builtin_bit_cast(uint32x4_t, c.to_native()));
      return simd<std::uint32_t, 4, Arch>::from_native(
        __builtin_bit_cast(typename simd<std::uint32_t, 4, Arch>::native_type, result));
    }
  }

  /// Evaluate constant operands without the SM3 instruction feature.
  template<isa<arm> Arch>
    requires(!Arch.has(arm_feature::sm3) && requires { sizeof(simd<std::uint32_t, 4, Arch>); })
  native_nodiscard consteval simd<std::uint32_t, 4, Arch> sm3partw2(simd<std::uint32_t, 4, Arch> a,
    simd<std::uint32_t, 4, Arch> b, simd<std::uint32_t, 4, Arch> c) noexcept {
    return detail::arm_sm3_constant::sm3partw2(a, b, c);
  }

  /// \}
} // namespace native
#endif
