module;
#include "native/isa_import.h"
#include "native/x86/f16c.h"
#include "native/x86/f16c_control.h"
#include "native/x86/instruction_storage.h"
#include "native/detail/constexpr_float.h"
#include "native/targets.h"
export module native.x86.f16c;
export import native.x86.features;
export import native.simd;
#if NATIVE_HOST_X86 || defined(NATIVE_DOXYGEN)
namespace native::detail {
  template<unsigned Imm8> constexpr auto f16c_rounding() noexcept {
    using r=constexpr_float::rounding;
    if constexpr(Imm8&4) return r::nearest_even;
    else if constexpr((Imm8&3)==1) return r::downward;
    else if constexpr((Imm8&3)==2) return r::upward;
    else if constexpr((Imm8&3)==3) return r::toward_zero;
    else return r::nearest_even;
  }
  template<unsigned Imm8> constexpr auto f16c_control() noexcept {
    x86_f16c::control result{f16c_rounding<Imm8>(), {}};
    if !consteval {
      result = x86_f16c::current_control();
      if constexpr (!(Imm8 & 4)) result.mode = f16c_rounding<Imm8>();
    }
    return result;
  }
  template<unsigned Imm8> constexpr std::uint16_t f16c_narrow_bits(std::uint32_t bits) noexcept {
    auto control = f16c_control<Imm8>();
    return constexpr_float::convert_bits<constexpr_float::binary16,constexpr_float::binary32>(
      bits, control.mode, control.environment);
  }
  template<isa<x86> Arch,unsigned Imm8,std::size_t N>
  constexpr simd<fp16,N,Arch> f16c_narrow(simd<float,N,Arch> input) noexcept {
    std::array<float,N> values{};input.store(values.data());
    auto source=std::bit_cast<std::array<std::uint32_t,N>>(values);
    std::array<std::uint16_t,N> result{};
    auto control = f16c_control<Imm8>();
    for(std::size_t i=0;i<N;++i) result[i]=constexpr_float::convert_bits<
      constexpr_float::binary16,constexpr_float::binary32>(source[i],control.mode,control.environment);
    return simd<fp16,N,Arch>::load_bits(result.data());
  }
  template<isa<x86> Arch,std::size_t N>
  constexpr simd<float,N,Arch> f16c_widen(simd<fp16,N,Arch> input) noexcept {
    std::array<std::uint16_t,N> source{};
    std::array<std::uint32_t,N> result{};
    input.store_bits(source.data());
    for(std::size_t i=0;i<N;++i) result[i]=constexpr_float::convert_bits<
      constexpr_float::binary32,constexpr_float::binary16>(source[i]);
    auto values=std::bit_cast<std::array<float,N>>(result);
    return simd<float,N,Arch>::load(values.data());
  }
}
export namespace native {
/** \defgroup x86_f16c F16C
 * \ingroup cpu_x86
 * Binary32 / IEEE binary16 conversions using VEX VCVTPS2PH and VCVTPH2PS.
 * Native forms require f16c; its compiler prerequisite is AVX. Callers must enable
 * a matching target and admit CPU support and XMM/YMM OS state separately.
 * No AVX2 or AVX512FP16 instructions are required.
 *
 * Packed operands and results use simd<float,N,Arch> and simd<fp16,N,Arch>.
 * Half vectors preserve representation bits; no scalar numerical conversion
 * is used at the vector boundary. Scalar forms use float and uint16_t half bits.
 *
 * Imm8 accepts every byte, 0..255. Bit 2 selects MXCSR.RC; otherwise bits 1:0
 * select nearest-even (0), down (1), up (2), or toward zero (3). Bits 7:3 are
 * ignored by the instruction: in particular, bit 3 does NOT suppress exceptions.
 * Narrowing ignores FTZ and honors DAZ for binary32 subnormal inputs. Widening
 * ignores DAZ and does not raise a denormal exception for binary16 subnormals.
 * Signs of zero and infinity are preserved. NaNs retain their sign and high
 * payload bits and are quieted; signaling NaNs raise invalid.
 *
 * Native operations retain architectural MXCSR status updates and unmasked
 * exceptions even if their result is discarded. They do not modify control
 * bits or masks. Runtime calls are neither const nor pure.
 * Constant evaluation uses masked exceptions, gradual inputs/results, and
 * nearest-even for the current-rounding immediate; no status effects occur.
 * Without F16C, polyfill permits runtime value emulation using MXCSR rounding
 * and DAZ controls. Fallback exception flags are unspecified and traps must be
 * masked; FTZ remains ignored. Without permission only consteval forms exist.
 * \{ */

  /// Convert 4 binary32 lanes to 4 binary16 lanes.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::f16c) && Imm8 <= 255)
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  simd<fp16, 4, Arch> cvtps_ph(simd<float, 4, Arch> a) noexcept {
    if consteval { return detail::f16c_narrow<Arch,Imm8>(a); } else {
      // VCVTPS2PH zeroes the unused high half of its destination.
      return detail::x86_half_result<simd<fp16, 4, Arch>>(
        detail::x86_f16c::cvtps_ph<Arch, Imm8>(detail::x86_float_register(a)));
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<isa<x86> Arch, unsigned Imm8>
    requires(requires { sizeof(simd<float,4,Arch>); sizeof(simd<fp16,4,Arch>); } && !Arch.has(x86_feature::f16c) && Imm8 <= 255 && !Arch.has(polyfill))
  [[nodiscard]] consteval
  simd<fp16, 4, Arch> cvtps_ph(simd<float, 4, Arch> a) noexcept {
    return detail::f16c_narrow<Arch,Imm8>(a);
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<isa<x86> Arch, unsigned Imm8>
    requires(requires { sizeof(simd<float,4,Arch>); sizeof(simd<fp16,4,Arch>); } && !Arch.has(x86_feature::f16c) && Imm8 <= 255 && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  simd<fp16, 4, Arch> cvtps_ph(simd<float, 4, Arch> a) noexcept {
    return detail::f16c_narrow<Arch,Imm8>(a);
  }

  /// Convert 8 binary32 lanes to 8 binary16 lanes.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::f16c) && Imm8 <= 255)
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  simd<fp16, 8, Arch> cvtps_ph(simd<float, 8, Arch> a) noexcept {
    if consteval { return detail::f16c_narrow<Arch,Imm8>(a); } else {
      return detail::x86_half_result<simd<fp16, 8, Arch>>(
        detail::x86_f16c::cvtps_ph<Arch, Imm8>(detail::x86_float_register(a)));
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<isa<x86> Arch, unsigned Imm8>
    requires(requires { sizeof(simd<float,8,Arch>); sizeof(simd<fp16,8,Arch>); } && !Arch.has(x86_feature::f16c) && Imm8 <= 255 && !Arch.has(polyfill))
  [[nodiscard]] consteval
  simd<fp16, 8, Arch> cvtps_ph(simd<float, 8, Arch> a) noexcept {
    return detail::f16c_narrow<Arch,Imm8>(a);
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<isa<x86> Arch, unsigned Imm8>
    requires(requires { sizeof(simd<float,8,Arch>); sizeof(simd<fp16,8,Arch>); } && !Arch.has(x86_feature::f16c) && Imm8 <= 255 && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  simd<fp16, 8, Arch> cvtps_ph(simd<float, 8, Arch> a) noexcept {
    return detail::f16c_narrow<Arch,Imm8>(a);
  }

  /// Widen 4 binary16 lanes to 4 binary32 lanes.
  template<isa<x86> Arch, unsigned Lanes>
    requires(Arch.has(x86_feature::f16c) && Lanes == 4)
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  simd<float, 4, Arch> cvtph_ps(simd<fp16, 4, Arch> a) noexcept {
    if consteval { return detail::f16c_widen<Arch>(a); } else {
      return detail::x86_instruction_result<simd<float, 4, Arch>>(
        detail::x86_f16c::cvtph_ps<Arch, 4>(detail::x86_half_register(a)));
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<isa<x86> Arch, unsigned Lanes>
    requires(requires { sizeof(simd<float,4,Arch>); sizeof(simd<fp16,4,Arch>); } && !Arch.has(x86_feature::f16c) && Lanes == 4 && !Arch.has(polyfill))
  [[nodiscard]] consteval
  simd<float, 4, Arch> cvtph_ps(simd<fp16, 4, Arch> a) noexcept {
    return detail::f16c_widen<Arch>(a);
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<isa<x86> Arch, unsigned Lanes>
    requires(requires { sizeof(simd<float,4,Arch>); sizeof(simd<fp16,4,Arch>); } && !Arch.has(x86_feature::f16c) && Lanes == 4 && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  simd<float, 4, Arch> cvtph_ps(simd<fp16, 4, Arch> a) noexcept {
    return detail::f16c_widen<Arch>(a);
  }

  /// Widen 8 binary16 lanes to 8 binary32 lanes.
  template<isa<x86> Arch, unsigned Lanes>
    requires(Arch.has(x86_feature::f16c) && Lanes == 8)
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  simd<float, 8, Arch> cvtph_ps(simd<fp16, 8, Arch> a) noexcept {
    if consteval { return detail::f16c_widen<Arch>(a); } else {
      return detail::x86_instruction_result<simd<float, 8, Arch>>(
        detail::x86_f16c::cvtph_ps<Arch, 8>(detail::x86_half_register(a)));
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<isa<x86> Arch, unsigned Lanes>
    requires(requires { sizeof(simd<float,8,Arch>); sizeof(simd<fp16,8,Arch>); } && !Arch.has(x86_feature::f16c) && Lanes == 8 && !Arch.has(polyfill))
  [[nodiscard]] consteval
  simd<float, 8, Arch> cvtph_ps(simd<fp16, 8, Arch> a) noexcept {
    return detail::f16c_widen<Arch>(a);
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<isa<x86> Arch, unsigned Lanes>
    requires(requires { sizeof(simd<float,8,Arch>); sizeof(simd<fp16,8,Arch>); } && !Arch.has(x86_feature::f16c) && Lanes == 8 && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  simd<float, 8, Arch> cvtph_ps(simd<fp16, 8, Arch> a) noexcept {
    return detail::f16c_widen<Arch>(a);
  }

  /// Convert one binary32 value to binary16 representation bits.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::f16c) && Imm8 <= 255)
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  std::uint16_t cvtss_sh(float a) noexcept {
    if consteval { return detail::f16c_narrow_bits<Imm8>(std::bit_cast<std::uint32_t>(a)); } else {
      return detail::x86_f16c::cvtss_sh<Arch, Imm8>(a);
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<isa<x86> Arch, unsigned Imm8>
    requires(!Arch.has(x86_feature::f16c) && Imm8 <= 255 && !Arch.has(polyfill))
  [[nodiscard]] consteval
  std::uint16_t cvtss_sh(float a) noexcept {
    return detail::f16c_narrow_bits<Imm8>(std::bit_cast<std::uint32_t>(a));
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<isa<x86> Arch, unsigned Imm8>
    requires(!Arch.has(x86_feature::f16c) && Imm8 <= 255 && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  std::uint16_t cvtss_sh(float a) noexcept {
    return detail::f16c_narrow_bits<Imm8>(std::bit_cast<std::uint32_t>(a));
  }

  /// Convert one binary32 value using the module baseline or an explicit ISA.
  /// Both cvtss_sh<Imm8, Arch> and cvtss_sh<Arch, Imm8> select the same operation.
  template<unsigned Imm8, isa<x86> Arch = NATIVE_BASELINE>
    requires(Arch.has(x86_feature::f16c) && Imm8 <= 255)
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  std::uint16_t cvtss_sh(float a) noexcept {
    if consteval { return detail::f16c_narrow_bits<Imm8>(std::bit_cast<std::uint32_t>(a)); } else {
      return cvtss_sh<Arch, Imm8>(a);
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<unsigned Imm8, isa<x86> Arch = NATIVE_BASELINE>
    requires(!Arch.has(x86_feature::f16c) && Imm8 <= 255 && !Arch.has(polyfill))
  [[nodiscard]] consteval
  std::uint16_t cvtss_sh(float a) noexcept {
    return detail::f16c_narrow_bits<Imm8>(std::bit_cast<std::uint32_t>(a));
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<unsigned Imm8, isa<x86> Arch = NATIVE_BASELINE>
    requires(!Arch.has(x86_feature::f16c) && Imm8 <= 255 && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  std::uint16_t cvtss_sh(float a) noexcept {
    return detail::f16c_narrow_bits<Imm8>(std::bit_cast<std::uint32_t>(a));
  }

  /// Widen one binary16 representation to binary32.
  template<isa<x86> Arch = NATIVE_BASELINE> requires(Arch.has(x86_feature::f16c))
  [[nodiscard]] hint_inline hint_target("f16c") constexpr
  float cvtsh_ss(std::uint16_t a) noexcept {
    if consteval { return std::bit_cast<float>(detail::constexpr_float::convert_bits<
      detail::constexpr_float::binary32,detail::constexpr_float::binary16>(a)); } else {
      return detail::x86_f16c::cvtsh_ss<Arch>(a);
    }
  }

  /// Constant-evaluation-only form for an ISA without F16C.
  template<isa<x86> Arch = NATIVE_BASELINE> requires(!Arch.has(x86_feature::f16c) && !Arch.has(polyfill))
  [[nodiscard]] consteval
  float cvtsh_ss(std::uint16_t a) noexcept {
    return std::bit_cast<float>(detail::constexpr_float::convert_bits<
      detail::constexpr_float::binary32,detail::constexpr_float::binary16>(a));
  }

  /// Emulate values when Arch explicitly permits polyfills.
  template<isa<x86> Arch = NATIVE_BASELINE> requires(!Arch.has(x86_feature::f16c) && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr
  float cvtsh_ss(std::uint16_t a) noexcept {
    return std::bit_cast<float>(detail::constexpr_float::convert_bits<
      detail::constexpr_float::binary32,detail::constexpr_float::binary16>(a));
  }

  /// Reject unsupported signatures, including implicit raw-register conversions.
  template<isa<x86> Arch, unsigned Imm8, class V> void cvtps_ph(V) = delete;
  /// Reject unsupported signatures, including implicit raw-register conversions.
  template<isa<x86> Arch, unsigned Lanes, class V> void cvtph_ps(V) = delete;
  /// \}
}
#endif
