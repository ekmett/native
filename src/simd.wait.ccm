module;
#include <cstdint>
#include <x86intrin.h>
#include "simd/attributes.h"

export module simd.wait;
import simd.cpu.x86;

export namespace simd {
  /// \defgroup wait Waiting
  /// \{

  /// \brief some way to wait for a value to change
  /// \tparam T type to check
  template <typename T>
  concept waiter = requires (volatile void * p, std::uint32_t t) {
    bool(T::supported);
    T::monitor(p);
    T::mwait(t);
  };

  /// \brief Wait until a predicate holds about a given memory location
  /// \param p pointer to data. activity on its cache line will wake us up
  /// \param f predicate to check about the pointer
  ///
  /// \pre W::supported is true. The predicate provides any required atomic
  /// synchronization; volatile access alone is not inter-thread synchronization.
  /// Wakeups may be spurious, so the predicate is checked again after monitoring.
  /// \post f(p)
  /// \snippet api.cc capabilities
  template <waiter W> simd_flatten
  void wait_until(volatile auto * p, auto f)
    noexcept(noexcept(!f(p)) && noexcept(W::monitor(p)) && noexcept(W::mwait(0))) simd_blocking {
    [[assume(W::supported)]];
    while (!f(p)) {
      W::monitor(p);
      if (!f(p))
        W::mwait(0);
    }
  }

  /// \ref waiter using the MONITORX/MWAITX instruction feature
  struct mwaitx {
    using timer_t = std::uint64_t;
    /// Arm MONITORX for p; call only when supported is true.
    [[gnu::target("mwaitx")]] static void monitor(volatile void * p) noexcept;
    /// Issue MWAITX with the supplied timer operand; monitor must already be armed.
    [[gnu::target("mwaitx")]] static void mwait(std::uint32_t timer = 0) noexcept simd_blocking;
    /// \hideinitializer \hideinlinesource
    static const bool supported;
  };


  /// \ref waiter using the WAITPKG instruction feature
  struct umwait {
    using timer_t = std::uint64_t;
    /// Arm UMONITOR for p; call only when supported is true.
    [[gnu::target("waitpkg")]] static void monitor(volatile void * p) noexcept;
    /// Issue UMWAIT with this absolute deadline operand; return the intrinsic status.
    [[gnu::target("waitpkg")]] static std::uint8_t mwait(std::uint32_t timer = 0) noexcept simd_blocking;
    /// \hideinlinesource
    static const bool supported;
  };

  /// A universally supported x86 spin waiter using PAUSE; monitor is a no-op.
  struct spin {
    using timer_t = std::uint64_t;
    /// Ignore the address; PAUSE waiting does not arm a hardware monitor.
    simd_inline simd_artificial static void monitor(volatile void *) noexcept {}
    /// Issue one PAUSE, ignoring the timer; no sleep duration or memory ordering is promised.
    simd_inline simd_artificial static void mwait(std::uint32_t = 0) noexcept simd_blocking { _mm_pause(); }
    /// \hideinlinesource
    inline static constinit bool supported = true;
  };

  /// \brief finds an appropriate waiter for the current CPU
  /// Prefer MWAITX, then WAITPKG, otherwise PAUSE. Invoke k once with that type.
  /// Runtime detection occurs here, not in a SIMD arithmetic operation.
  /// Usage:
  /// \code{.cpp}
  ///   with_waiter([&]<waiter W> { wait_until<W>(p, predicate); });
  /// \endcode
  /// invokes \p k with a waiter as a template parameter.
  auto with_waiter(auto k)
    noexcept(noexcept(k.template operator()<mwaitx>()) &&
      noexcept(k.template operator()<umwait>()) && noexcept(k.template operator()<spin>())) {
    if (mwaitx::supported) return k.template operator()<mwaitx>();
    else if (umwait::supported) return k.template operator()<umwait>();
    else return k.template operator()<spin>();
  }

  /// \}
}

namespace simd {
  // Out-of-line module-owned leaves avoid exposing the intrinsic headers'
  // TU-local inline functions through a BMI, and preserve baseline callers.
  [[gnu::target("mwaitx")]] void mwaitx::monitor(volatile void * p) noexcept {
    _mm_monitorx(const_cast<void *>(p), 0, 0);
  }
  [[gnu::target("mwaitx")]] void mwaitx::mwait(std::uint32_t timer) noexcept simd_blocking {
    _mm_mwaitx(0, 0, timer);
  }
  [[gnu::target("waitpkg")]] void umwait::monitor(volatile void * p) noexcept {
    _umonitor(const_cast<void *>(p));
  }
  [[gnu::target("waitpkg")]] std::uint8_t umwait::mwait(std::uint32_t timer) noexcept simd_blocking {
    return _umwait(1, timer);
  }

  // CPUID maxima gate the requested leaves. Vendor identity is not admission.
  const bool mwaitx::supported = [] static noexcept {
    auto maximum = static_cast<std::uint32_t>(cpuid(static_cast<std::int32_t>(0x80000000u), 0).eax);
    return maximum >= 0x80000001u &&
      (cpuid(static_cast<std::int32_t>(0x80000001u), 0).ecx & (1 << 29)) != 0;
  }();

  const bool umwait::supported = [] static noexcept {
    return static_cast<std::uint32_t>(cpuid(0, 0).eax) >= 7u &&
      (cpuid(7, 0).ecx & (1 << 5)) != 0;
  }();
}
