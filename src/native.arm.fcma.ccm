  }

  /// FCMLA on 2 binary32 complex pair(s), rotation in degrees.
  template<isa<arm> Arch, unsigned Rotation> requires(Arch.has(arm_feature::complxnum)
    && (Rotation == 0 || Rotation == 90 || Rotation == 180 || Rotation == 270))
