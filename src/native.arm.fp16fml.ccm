    }
  }

  /// Constant-evaluation-only form when the instruction feature is absent.
  template<isa<arm> Arch, unsigned Lane> requires(!Arch.has(polyfill) && requires { sizeof(simd<float, 2, Arch>); } && requires { sizeof(simd<fp16, 4, Arch>); } && requires { sizeof(simd<fp16, 8, Arch>); } && !(Arch.has(arm_feature::fp16fml)) && Lane < 8)
  [[nodiscard]] consteval
  simd<float, 2, Arch> fmlal_lane(
      simd<float, 2, Arch> acc,
      simd<fp16, 4, Arch> a,
      simd<fp16, 8, Arch> b) noexcept {
