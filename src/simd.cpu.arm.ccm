module;
#include <cstdint>
#include <cstddef>
#include "simd/isa.h"
#if defined(__APPLE__)
#include <cerrno>
#include <sys/sysctl.h>
#elif defined(__linux__)
#include <cerrno>
#include <sys/auxv.h>
#include <asm/hwcap.h>
#elif defined(_WIN32)
#ifndef NOMINMAX
#define NOMINMAX
#endif
// Import only the SDK contract used here. The full umbrella also declares UI
// APIs with anonymous parameter types that cannot be merged after a BMI import.
// Standalone SDK headers require the architecture marker normally set by windows.h.
#if defined(_M_ARM64) && !defined(_ARM64_)
#define _ARM64_
#endif
#include <processthreadsapi.h>
#endif

export module simd.cpu.arm;
#include "simd/isa_capability_exports.h"

export namespace simd {
  /// \defgroup arm_capabilities ARM capabilities
  /// AArch64 OS capability admission, independent of the native SIMD hub.
  /// Query before entering optional-profile code; no instruction probing occurs.

  /// \ingroup arm_capabilities
  /// Normalized OS-advertised capabilities. False observation flags reject even
  /// if a feature Boolean contains stale true data. Unknown platforms reject.
  /// This records OS availability, not a CPU model or an independent ISA probe.
  struct arm_capabilities {
    /// True only after the OS baseline FP/Advanced SIMD query succeeds.
    bool baseline_observed = false;
    /// OS permits baseline floating-point instructions and their register state.
    bool fp = false;
    /// OS permits baseline Advanced SIMD instructions and their register state.
    bool asimd = false;
    /// True only after an OS half-arithmetic feature query succeeds.
    bool fp16_observed = false;
    /// OS advertises scalar half-precision arithmetic (FPHP/FEAT_FP16).
    bool scalar_fp16 = false;
    /// OS advertises Advanced SIMD half-precision arithmetic (ASIMDHP/FEAT_FP16).
    bool vector_fp16 = false;
    /// True only after an OS BF16 feature query succeeds.
    bool bf16_observed = false;
    /// OS advertises non-streaming Advanced SIMD BF16 instructions (FEAT_BF16).
    bool bf16 = false;
    /// True only after an OS enhanced BF16 feature query succeeds.
    bool ebf16_observed = false;
    /// OS advertises enhanced BF16 behavior, usable when the caller sets FPCR.EBF.
    /// Informational: NEON_BF16 admission does not require this extension.
    bool ebf16 = false;
    /// Additional source-target features, as ISA values.
    /// A feature must occur in both sets; failed queries never authorize it.
    isa extra_observed{}, extra_features{};
  };

  /// \ingroup arm_capabilities
  /// Query OS-advertised AArch64 features without executing optional instructions.
  /// Linux uses AT_HWCAP/AT_HWCAP2; macOS uses feature sysctls (legacy FP16 only if the modern
  /// key is unavailable, never after a false value); Windows uses processor-feature
  /// queries. Failed/unavailable observations reject. Old Windows systems report
  /// FP16 unavailable even when their hardware might implement it. FPCR is untouched.
  arm_capabilities observe_arm_capabilities() noexcept;
}

namespace simd {
  arm_capabilities observe_arm_capabilities() noexcept {
    arm_capabilities result;
#if defined(__APPLE__)
    auto query=[](char const * key, bool & value) noexcept {
      int data=0; std::size_t size=sizeof(data);
      if(sysctlbyname(key,&data,&size,nullptr,0)!=0) return errno==ENOENT ? 0 : -1;
      if(size!=sizeof(data)) return -1;
      value=data!=0; return 1;
    };
    bool baseline=false, half=false;
    result.baseline_observed=query("hw.optional.neon",baseline)==1;
    result.fp=result.asimd=baseline;
    auto status=query("hw.optional.arm.FEAT_FP16",half);
    if(status==0) status=query("hw.optional.neon_fp16",half);
    result.fp16_observed=status==1;
    result.scalar_fp16=result.vector_fp16=half;
    result.bf16_observed=query("hw.optional.arm.FEAT_BF16",result.bf16)==1;
    result.ebf16_observed=query("hw.optional.arm.FEAT_EBF16",result.ebf16)==1;
    auto extra=[&](feature f,char const * first,char const * second=nullptr) {
      bool a=false,b=true;
      auto observed=query(first,a)==1;
      if(second) observed=(query(second,b)==1)&&observed;
      if(observed) result.extra_observed.set(f,true);
      if(observed && a && b) result.extra_features.set(f,true);
    };
    // Clang AES includes PMULL, SHA2 includes SHA1/SHA256, and SHA3 includes
    // SHA512. Query every component rather than assuming one implies another.
    extra(feature::arm_aes,"hw.optional.arm.FEAT_AES","hw.optional.arm.FEAT_PMULL");
    extra(feature::arm_sha2,"hw.optional.arm.FEAT_SHA1","hw.optional.arm.FEAT_SHA256");
    extra(feature::arm_sha3,"hw.optional.arm.FEAT_SHA3","hw.optional.arm.FEAT_SHA512");
    extra(feature::arm_crc,"hw.optional.armv8_crc32");
    extra(feature::arm_lse,"hw.optional.arm.FEAT_LSE");
    extra(feature::arm_rdm,"hw.optional.arm.FEAT_RDM");
    extra(feature::arm_fp16fml,"hw.optional.arm.FEAT_FHM");
    extra(feature::arm_dotprod,"hw.optional.arm.FEAT_DotProd");
    extra(feature::arm_complxnum,"hw.optional.arm.FEAT_FCMA");
    extra(feature::arm_jsconv,"hw.optional.arm.FEAT_JSCVT");
    extra(feature::arm_rcpc,"hw.optional.arm.FEAT_LRCPC");
    extra(feature::arm_pauth,"hw.optional.arm.FEAT_PAuth");
#elif defined(__linux__)
    errno=0;
    auto hwcap=getauxval(AT_HWCAP);
    if(hwcap==0 && errno!=0) return result;
    result.baseline_observed=result.fp16_observed=true;
    result.fp=(hwcap&HWCAP_FP)!=0;
    result.asimd=(hwcap&HWCAP_ASIMD)!=0;
    result.scalar_fp16=(hwcap&HWCAP_FPHP)!=0;
    result.vector_fp16=(hwcap&HWCAP_ASIMDHP)!=0;
    auto extra=[&](feature f,unsigned long mask) {
      result.extra_observed.set(f,true);
      if((hwcap&mask)==mask) result.extra_features.set(f,true);
    };
    extra(feature::arm_aes,HWCAP_AES|HWCAP_PMULL);
    extra(feature::arm_sha2,HWCAP_SHA1|HWCAP_SHA2);
    extra(feature::arm_crc,HWCAP_CRC32);
    extra(feature::arm_lse,HWCAP_ATOMICS);
#ifdef HWCAP_ASIMDRDM
    extra(feature::arm_rdm,HWCAP_ASIMDRDM);
#endif
#ifdef HWCAP_ASIMDFHM
    extra(feature::arm_fp16fml,HWCAP_ASIMDFHM);
#endif
#ifdef HWCAP_ASIMDDP
    extra(feature::arm_dotprod,HWCAP_ASIMDDP);
#endif
#ifdef HWCAP_FCMA
    extra(feature::arm_complxnum,HWCAP_FCMA);
#endif
#ifdef HWCAP_JSCVT
    extra(feature::arm_jsconv,HWCAP_JSCVT);
#endif
#ifdef HWCAP_LRCPC
    extra(feature::arm_rcpc,HWCAP_LRCPC);
#endif
#if defined(HWCAP_SHA3) && defined(HWCAP_SHA512)
    extra(feature::arm_sha3,HWCAP_SHA3|HWCAP_SHA512);
#endif
#if defined(HWCAP_PACA) && defined(HWCAP_PACG)
    extra(feature::arm_pauth,HWCAP_PACA|HWCAP_PACG);
#endif
    errno=0;
    auto hwcap2=getauxval(AT_HWCAP2);
    if(hwcap2!=0 || errno==0) {
#ifdef HWCAP2_BF16
      result.bf16_observed=true;
      result.bf16=(hwcap2&HWCAP2_BF16)!=0;
#endif
#ifdef HWCAP2_EBF16
      result.ebf16_observed=true;
      result.ebf16=(hwcap2&HWCAP2_EBF16)!=0;
#endif
    }
#elif defined(_WIN32)
    result.baseline_observed=result.fp16_observed=true;
    result.fp=IsProcessorFeaturePresent(PF_ARM_V8_INSTRUCTIONS_AVAILABLE)!=0;
    result.asimd=IsProcessorFeaturePresent(PF_ARM_NEON_INSTRUCTIONS_AVAILABLE)!=0;
    // Documented SDK 26100 selector; older HALs return false for unknown features.
    constexpr DWORD fp16_feature=67; // PF_ARM_V82_FP16_INSTRUCTIONS_AVAILABLE
    result.scalar_fp16=result.vector_fp16=IsProcessorFeaturePresent(fp16_feature)!=0;
    constexpr DWORD bf16_feature=68; // PF_ARM_V86_BF16_INSTRUCTIONS_AVAILABLE
    constexpr DWORD ebf16_feature=69; // PF_ARM_V86_EBF16_INSTRUCTIONS_AVAILABLE
    result.bf16_observed=result.ebf16_observed=true;
    result.bf16=IsProcessorFeaturePresent(bf16_feature)!=0;
    result.ebf16=IsProcessorFeaturePresent(ebf16_feature)!=0;
    auto extra=[&](feature f,DWORD selector) {
      result.extra_observed.set(f,true);
      if(IsProcessorFeaturePresent(selector)) result.extra_features.set(f,true);
    };
    extra(feature::arm_aes,PF_ARM_V8_CRYPTO_INSTRUCTIONS_AVAILABLE);
    extra(feature::arm_sha2,PF_ARM_V8_CRYPTO_INSTRUCTIONS_AVAILABLE);
    extra(feature::arm_crc,PF_ARM_V8_CRC32_INSTRUCTIONS_AVAILABLE);
    extra(feature::arm_lse,PF_ARM_V81_ATOMIC_INSTRUCTIONS_AVAILABLE);
    extra(feature::arm_dotprod,43); // PF_ARM_V82_DP_INSTRUCTIONS_AVAILABLE
    extra(feature::arm_jsconv,44); // PF_ARM_V83_JSCVT_INSTRUCTIONS_AVAILABLE
    extra(feature::arm_rcpc,45); // PF_ARM_V83_LRCPC_INSTRUCTIONS_AVAILABLE
    result.extra_observed.set(feature::arm_sha3,true);
    if(IsProcessorFeaturePresent(64) && IsProcessorFeaturePresent(65))
      result.extra_features.set(feature::arm_sha3,true); // SHA3 and SHA512
    // Windows exposes no selectors for the remaining catalog entries here;
    // leave them unobserved, even if a CPU model is usually known to have them.
#endif
    return result;
  }
}
