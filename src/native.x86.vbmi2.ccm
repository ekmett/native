module;
#include "native/isa_import.h"
#include "native/x86/vbmi2.h"
export module native.x86.vbmi2;
export import native.x86.features;
export import native.simd;
// SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0

#if NATIVE_HOST_X86 || defined(NATIVE_DOXYGEN)
export namespace native {
  /** \defgroup x86_vbmi2 AVX512VBMI2
   * Byte/word compaction, packed memory transfers and double-source shifts.
   * Runtime targets require AVX512F, AVX512BW and AVX512VBMI2; 128/256-bit
   * forms also require AVX512VL. Admit CPU features and OS ZMM state first.
   * Compress preserves source above the packed prefix; expand preserves source
   * at inactive mask positions. Memory forms access exactly popcount(mask)
   * typed elements; a null pointer is valid only for an empty logical mask.
   * Shift counts use the low log2(element bits) bits. Immediate values must fit
   * an unsigned byte. Variable merging forms retain a at inactive positions.
   * Weaker feature tags support constant evaluation when storage is available.
   * \{ */

  /// Pack selected lanes in order into the low result lanes. Inactive result lanes retain source.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> mask_vpcompressb(
    simd<std::uint8_t, 16, Arch> source,
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<false>(source, mask.to_bitset(), value);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi2::mask_vpcompressb<Arch>(
          source.to_native(), mask.to_bitset(), value.to_native()));
    }
  }

  /// Pack selected lanes in order into the low result lanes. Remaining result lanes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> maskz_vpcompressb(
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<false>(simd<std::uint8_t, 16, Arch>{}, mask.to_bitset(), value);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpcompressb<Arch>(
          mask.to_bitset(), value.to_native()));
    }
  }

  /// Store selected lanes in order; destination has popcount(mask) writable elements, or may be null if empty.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_inline native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr void mask_vpcompressb(
    std::uint8_t * destination,
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      detail::x86_vbmi2_constant::compress_store(destination, mask.to_bitset(), value);
    } else {
      detail::x86_vbmi2::mask_vpcompressb<Arch>(
          destination, mask.to_bitset(), value.to_native());
    }
  }

  /// Expand the packed prefix into selected lanes. Inactive result lanes retain source.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> mask_vpexpandb(
    simd<std::uint8_t, 16, Arch> source,
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<true>(source, mask.to_bitset(), value);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi2::mask_vpexpandb<Arch>(
          source.to_native(), mask.to_bitset(), value.to_native()));
    }
  }

  /// Expand the packed prefix into selected lanes. Remaining result lanes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> maskz_vpexpandb(
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<true>(simd<std::uint8_t, 16, Arch>{}, mask.to_bitset(), value);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpexpandb<Arch>(
          mask.to_bitset(), value.to_native()));
    }
  }

  /// Expand popcount(mask) readable elements; memory may be null if the logical mask is empty.
  template<isa<x86> Arch, class T>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) &&
      (std::same_as<T, std::uint8_t> || std::same_as<T, std::uint8_t const>))
  native_nodiscard native_inline native_pure native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> mask_vpexpandb(
    simd<std::uint8_t, 16, Arch> source,
    predicate<16, Arch> mask,
    T * memory) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::expand_load(source, mask.to_bitset(), memory);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi2::mask_vpexpandb<Arch>(
          source.to_native(), mask.to_bitset(), memory));
    }
  }

  /// Expand popcount(mask) readable elements; memory may be null if the logical mask is empty.
  template<isa<x86> Arch, class T>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) &&
      (std::same_as<T, std::uint8_t> || std::same_as<T, std::uint8_t const>))
  native_nodiscard native_inline native_pure native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> maskz_vpexpandb(
    predicate<16, Arch> mask,
    T * memory) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::expand_load(simd<std::uint8_t, 16, Arch>{}, mask.to_bitset(), memory);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpexpandb_128<Arch>(
          static_cast<__mmask16>(mask.to_bitset()), memory));
    }
  }

  /// Pack selected lanes in order into the low result lanes. Inactive result lanes retain source.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> mask_vpcompressw(
    simd<std::uint16_t, 8, Arch> source,
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<false>(source, mask.to_bitset(), value);
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::mask_vpcompressw<Arch>(
          source.to_native(), mask.to_bitset(), value.to_native()));
    }
  }

  /// Pack selected lanes in order into the low result lanes. Remaining result lanes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> maskz_vpcompressw(
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<false>(simd<std::uint16_t, 8, Arch>{}, mask.to_bitset(), value);
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpcompressw<Arch>(
          mask.to_bitset(), value.to_native()));
    }
  }

  /// Store selected lanes in order; destination has popcount(mask) writable elements, or may be null if empty.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_inline native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr void mask_vpcompressw(
    std::uint16_t * destination,
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> value) noexcept {
    if consteval {
      detail::x86_vbmi2_constant::compress_store(destination, mask.to_bitset(), value);
    } else {
      detail::x86_vbmi2::mask_vpcompressw<Arch>(
          destination, mask.to_bitset(), value.to_native());
    }
  }

  /// Expand the packed prefix into selected lanes. Inactive result lanes retain source.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> mask_vpexpandw(
    simd<std::uint16_t, 8, Arch> source,
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::compact<true>(source, mask.to_bitset(), value);
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::mask_vpexpandw<Arch>(
