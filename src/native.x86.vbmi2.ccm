  /// Expand popcount(mask) readable elements; memory may be null if the logical mask is empty.
  template<isa<x86> Arch, class T>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) &&
      (std::same_as<T, std::uint16_t> || std::same_as<T, std::uint16_t const>))
  native_nodiscard native_inline native_pure native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> maskz_vpexpandw(
    predicate<8, Arch> mask,
    T * memory) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::expand_load(simd<std::uint16_t, 8, Arch>{}, mask.to_bitset(), memory);
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpexpandw_128<Arch>(
          static_cast<__mmask8>(mask.to_bitset()), memory));
    }
  }

  /// Shift concatenated lanes left using Imm8.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) && Imm8 <= 255)
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> vpshldw(
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<false>(
        a, b, Imm8, simd<std::uint16_t, 8, Arch>{}, ~std::uint64_t{0});
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::vpshldw<Arch, Imm8>(
          a.to_native(), b.to_native()));
    }
  }

  /// Shift concatenated lanes left using Imm8. Inactive lanes retain source.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) && Imm8 <= 255)
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> mask_vpshldw(
    simd<std::uint16_t, 8, Arch> source,
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<false>(
        a, b, Imm8, source, mask.to_bitset());
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::mask_vpshldw<Arch, Imm8>(
          source.to_native(), mask.to_bitset(), a.to_native(), b.to_native()));
    }
  }

  /// Shift concatenated lanes left using Imm8. Inactive lanes become zero.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) && Imm8 <= 255)
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> maskz_vpshldw(
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<false>(
        a, b, Imm8, simd<std::uint16_t, 8, Arch>{}, mask.to_bitset());
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpshldw<Arch, Imm8>(
          mask.to_bitset(), a.to_native(), b.to_native()));
    }
  }

  /// Shift concatenated lanes left using per-lane counts.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> vpshldvw(
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b,
    simd<std::uint16_t, 8, Arch> counts) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<false>(
        a, b, counts, simd<std::uint16_t, 8, Arch>{}, ~std::uint64_t{0});
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::vpshldvw<Arch>(
          a.to_native(), b.to_native(), counts.to_native()));
    }
  }

  /// Shift concatenated lanes left using per-lane counts. Inactive lanes retain a.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> mask_vpshldvw(
    simd<std::uint16_t, 8, Arch> a,
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> b,
    simd<std::uint16_t, 8, Arch> counts) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<false>(
        a, b, counts, a, mask.to_bitset());
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::mask_vpshldvw<Arch>(
          a.to_native(), mask.to_bitset(), b.to_native(), counts.to_native()));
    }
  }

  /// Shift concatenated lanes left using per-lane counts. Inactive lanes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> maskz_vpshldvw(
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b,
    simd<std::uint16_t, 8, Arch> counts) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<false>(
        a, b, counts, simd<std::uint16_t, 8, Arch>{}, mask.to_bitset());
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::maskz_vpshldvw<Arch>(
          mask.to_bitset(), a.to_native(), b.to_native(), counts.to_native()));
    }
  }

  /// Shift concatenated lanes right using Imm8.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) && Imm8 <= 255)
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> vpshrdw(
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<true>(
        a, b, Imm8, simd<std::uint16_t, 8, Arch>{}, ~std::uint64_t{0});
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_vbmi2::vpshrdw<Arch, Imm8>(
          a.to_native(), b.to_native()));
    }
  }

  /// Shift concatenated lanes right using Imm8. Inactive lanes retain source.
  template<isa<x86> Arch, unsigned Imm8>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi2) &&
      Arch.has(x86_feature::avx512vl) && Imm8 <= 255)
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi2,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> mask_vpshrdw(
    simd<std::uint16_t, 8, Arch> source,
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> a,
    simd<std::uint16_t, 8, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi2_constant::shift<true>(
        a, b, Imm8, source, mask.to_bitset());
    } else {
