  /// Inactive destination lanes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> maskz_vpopcntw(
    predicate<8, Arch> mask,
    simd<std::uint16_t, 8, Arch> value) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::population(
        value, simd<std::uint16_t, 8, Arch>{}, mask.to_bitset());
    } else {
      return simd<std::uint16_t, 8, Arch>::from_native(
        detail::x86_bitalg::maskz_vpopcntw<Arch>(mask.to_bitset(), value.to_native()));
    }
  }

  /// Select one source bit for each control byte, within the corresponding qword.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr predicate<16, Arch> vpshufbitqmb(
    simd<std::uint64_t, 2, Arch> value,
    simd<std::uint8_t, 16, Arch> control) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::bitshuffle<predicate<16, Arch>>(
        value, control, ~std::uint64_t{0});
    } else {
      return predicate<16, Arch>::from_bitset(
        detail::x86_bitalg::vpshufbitqmb<Arch>(value.to_native(), control.to_native()));
    }
  }

  /// Select source bits for active output positions; inactive predicate bits become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr predicate<16, Arch> mask_vpshufbitqmb(
    predicate<16, Arch> mask,
    simd<std::uint64_t, 2, Arch> value,
    simd<std::uint8_t, 16, Arch> control) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::bitshuffle<predicate<16, Arch>>(
        value, control, mask.to_bitset());
    } else {
      return predicate<16, Arch>::from_bitset(
        detail::x86_bitalg::mask_vpshufbitqmb<Arch>(
          mask.to_bitset(),
          value.to_native(),
          control.to_native()));
    }
  }

