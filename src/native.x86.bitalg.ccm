module;
#include "native/isa_import.h"
#include "native/x86/bitalg.h"
export module native.x86.bitalg;
export import native.x86.features;
export import native.simd;
// SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0

#if NATIVE_HOST_X86 || defined(NATIVE_DOXYGEN)
export namespace native {
  /** \defgroup x86_bitalg AVX512BITALG
   * Byte/word population counts and qword bit selection into compact predicates.
   * Runtime targets require AVX512F, AVX512BW and AVX512BITALG; 128/256-bit
   * forms also require AVX512VL. AVX512BW follows Clang's BITALG target closure.
   * Admit CPU features and OS ZMM state before entering a matching target scope.
   * Population masks merge or zero destination lanes. Bitshuffle masks zero
   * inactive result bits. Control bytes select bits 0..63 of their source qword.
   * Constant evaluation uses exact integer semantics. Tags without instruction
   * features are compile-time-only and require complete SIMD storage.
   * \{ */

  /// Count set bits in each 8-bit lane.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> vpopcntb(
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::population(
        value, simd<std::uint8_t, 16, Arch>{}, ~std::uint64_t{0});
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_bitalg::vpopcntb<Arch>(value.to_native()));
    }
  }

  /// Inactive destination lanes retain source.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> mask_vpopcntb(
    simd<std::uint8_t, 16, Arch> source,
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::population(
        value, source, mask.to_bitset());
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_bitalg::mask_vpopcntb<Arch>(source.to_native(), mask.to_bitset(), value.to_native()));
    }
  }

  /// Inactive destination lanes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> maskz_vpopcntb(
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::population(
        value, simd<std::uint8_t, 16, Arch>{}, mask.to_bitset());
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_bitalg::maskz_vpopcntb<Arch>(mask.to_bitset(), value.to_native()));
    }
  }

  /// Count set bits in each 16-bit lane.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512bitalg) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512bitalg,avx512vl")
  constexpr simd<std::uint16_t, 8, Arch> vpopcntw(
    simd<std::uint16_t, 8, Arch> value) noexcept {
    if consteval {
      return detail::x86_bitalg_constant::population(
        value, simd<std::uint16_t, 8, Arch>{}, ~std::uint64_t{0});
    } else {
