module;
#include "native/x86/instruction_storage.h"

#include "native/isa_import.h"
#include "native/x86/sha.h"

export module native.x86.sha;
export import native.x86.features;
export import native.simd;

#if NATIVE_HOST_X86 || defined(NATIVE_DOXYGEN)
export namespace native {
  /// \defgroup x86_sha SHA
  /// \ingroup cpu_x86
  /// Four-dword register values follow the instruction packing, not four
  /// independent hashes. SHA-1 state and SHA-256 state packs run high-to-low;
  /// SHA-256 message words run low-to-high. Runtime calls require SHA and the
  /// matching compiler target. Constant evaluation is exact modulo 32 bits.
  /// Missing-feature forms accept constants; polyfill permits runtime emulation and missing storage.
  /// \{

  /// Four SHA-1 rounds; Selector in [0,3] selects the function and constant.
  template<isa<x86> Arch, unsigned Selector> requires(Arch.has(x86_feature::sha) && Selector < 4)
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha1rnds4(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    if consteval {
      return detail::x86_sha_constant::rounds1<Selector>(a, b);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha1rnds4<Arch, Selector>(detail::x86_integer_register(a), detail::x86_integer_register(b)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch, unsigned Selector> requires(!Arch.has(x86_feature::sha) && Selector < 4 &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha1rnds4(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::rounds1<Selector>(a, b);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch, unsigned Selector> requires(!Arch.has(x86_feature::sha) && Selector < 4 &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha1rnds4(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::rounds1<Selector>(a, b);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, unsigned Selector, class... Args>
  void sha1rnds4(Args...) = delete;

  /// Add the next E value, derived from a, to the high dword of b.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::sha))
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha1nexte(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    if consteval {
      return detail::x86_sha_constant::next_e(a, b);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha1nexte<Arch>(detail::x86_integer_register(a), detail::x86_integer_register(b)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha1nexte(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::next_e(a, b);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha1nexte(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::next_e(a, b);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void sha1nexte(Args...) = delete;

  /// First SHA-1 message-schedule step.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::sha))
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha1msg1(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    if consteval {
      return detail::x86_sha_constant::message1_first(a, b);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha1msg1<Arch>(detail::x86_integer_register(a), detail::x86_integer_register(b)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha1msg1(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message1_first(a, b);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha1msg1(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message1_first(a, b);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void sha1msg1(Args...) = delete;

  /// Final SHA-1 message-schedule step.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::sha))
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha1msg2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    if consteval {
      return detail::x86_sha_constant::message1_last(a, b);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha1msg2<Arch>(detail::x86_integer_register(a), detail::x86_integer_register(b)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha1msg2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message1_last(a, b);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha1msg2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message1_last(a, b);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void sha1msg2(Args...) = delete;

  /// Two SHA-256 rounds: a is CDGH, b is ABEF, c contains two message-plus-constant words.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::sha))
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha256rnds2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b, simd<std::uint32_t, 4, Arch> c) noexcept {
    if consteval {
      return detail::x86_sha_constant::rounds256(a, b, c);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha256rnds2<Arch>(detail::x86_integer_register(a), detail::x86_integer_register(b), detail::x86_integer_register(c)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha256rnds2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b, simd<std::uint32_t, 4, Arch> c) noexcept {
    return detail::x86_sha_constant::rounds256(a, b, c);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha256rnds2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b, simd<std::uint32_t, 4, Arch> c) noexcept {
    return detail::x86_sha_constant::rounds256(a, b, c);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void sha256rnds2(Args...) = delete;

  /// First SHA-256 message-schedule step.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::sha))
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha256msg1(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    if consteval {
      return detail::x86_sha_constant::message256_first(a, b);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha256msg1<Arch>(detail::x86_integer_register(a), detail::x86_integer_register(b)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha256msg1(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message256_first(a, b);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha256msg1(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message256_first(a, b);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void sha256msg1(Args...) = delete;

  /// Final SHA-256 message-schedule step.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::sha))
  [[nodiscard]] hint_inline hint_const hint_target("sha")
  constexpr simd<std::uint32_t, 4, Arch> sha256msg2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    if consteval {
      return detail::x86_sha_constant::message256_last(a, b);
    } else {
      return detail::x86_instruction_result<simd<std::uint32_t, 4, Arch>>(
        detail::x86_sha::sha256msg2<Arch>(detail::x86_integer_register(a), detail::x86_integer_register(b)));
    }
  }

  /// Evaluate constant operands without SHA.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && !Arch.has(polyfill))
  [[nodiscard]] consteval simd<std::uint32_t, 4, Arch> sha256msg2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message256_last(a, b);
  }

  /// Emulate the operation when Arch explicitly permits polyfills.
  template<isa<x86> Arch> requires(!Arch.has(x86_feature::sha) &&
      requires { sizeof(simd<std::uint32_t, 4, Arch>); } && Arch.has(polyfill))
  [[nodiscard]] hint_inline constexpr simd<std::uint32_t, 4, Arch> sha256msg2(
    simd<std::uint32_t, 4, Arch> a, simd<std::uint32_t, 4, Arch> b) noexcept {
    return detail::x86_sha_constant::message256_last(a, b);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void sha256msg2(Args...) = delete;

  /// \}
}
#endif
