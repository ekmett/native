  /// Evaluate constant operands without the instruction features.
  template<isa<x86> Arch> requires(!(Arch.has(x86_feature::vaes) && Arch.has(x86_feature::avx512f)) &&
      requires { sizeof(simd<std::uint8_t, 64, Arch>); })
  native_nodiscard consteval simd<std::uint8_t, 64, Arch> vaesenclast(
    simd<std::uint8_t, 64, Arch> state, simd<std::uint8_t, 64, Arch> key) noexcept {
    return detail::x86_vaes_constant::round<false, true>(state, key);
  }

  /// Reject raw registers, mixed tags and unsupported vector shapes.
  template<isa<x86> Arch, class... Args>
  void vaesenclast(Args...) = delete;

  /// One AES decryption round.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::aes) && Arch.has(x86_feature::avx))
  native_nodiscard native_inline native_const native_target("avx,aes")
  constexpr simd<std::uint8_t, 16, Arch> vaesdec(
    simd<std::uint8_t, 16, Arch> state, simd<std::uint8_t, 16, Arch> key) noexcept {
    if consteval {
      return detail::x86_vaes_constant::round<true, false>(state, key);
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vaes::vaesdec<Arch>(state.to_native(), key.to_native()));
    }
  }

  /// Evaluate constant operands without the instruction features.
  template<isa<x86> Arch> requires(!(Arch.has(x86_feature::aes) && Arch.has(x86_feature::avx)) &&
      requires { sizeof(simd<std::uint8_t, 16, Arch>); })
  native_nodiscard consteval simd<std::uint8_t, 16, Arch> vaesdec(
    simd<std::uint8_t, 16, Arch> state, simd<std::uint8_t, 16, Arch> key) noexcept {
    return detail::x86_vaes_constant::round<true, false>(state, key);
  }

  /// Two independent AES decryption rounds.
  template<isa<x86> Arch> requires(Arch.has(x86_feature::vaes) && Arch.has(x86_feature::avx))
  native_nodiscard native_inline native_const native_target("avx,vaes")
  constexpr simd<std::uint8_t, 32, Arch> vaesdec(
    simd<std::uint8_t, 32, Arch> state, simd<std::uint8_t, 32, Arch> key) noexcept {
    if consteval {
