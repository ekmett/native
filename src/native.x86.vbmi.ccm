module;
#include "native/isa_import.h"
#include "native/x86/vbmi.h"
export module native.x86.vbmi;
export import native.x86.features;
export import native.simd;
// SPDX-License-Identifier: BSD-2-Clause OR Apache-2.0

#if NATIVE_HOST_X86 || defined(NATIVE_DOXYGEN)
export namespace native {
  /** \defgroup x86_vbmi AVX512VBMI
   * Byte permutations across whole vectors and circular qword bit windows.
   * Runtime targets require AVX512F, AVX512BW and AVX512VBMI; 128/256-bit forms
   * also require AVX512VL. Admit CPU features and OS ZMM state before entry.
   * Single-table indices use log2(lanes) bits; two-table indices use one more.
   * VPERMI2B merges inactive index lanes; VPERMT2B merges inactive first-table
   * lanes. Multishift selects eight wrapping bits from the corresponding qword.
   * Constant evaluation uses exact integer semantics. Weaker tags are accepted
   * only at compile time and still require complete SIMD storage.
   * \{ */

  /// Permute bytes across the whole vector using the low index bits.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> vpermb(
    simd<std::uint8_t, 16, Arch> indices,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi_constant::permute<false>(
        indices, value, simd<std::uint8_t, 16, Arch>{}, simd<std::uint8_t, 16, Arch>{}, ~std::uint64_t{0});
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi::vpermb<Arch>(
          indices.to_native(), value.to_native()));
    }
  }

  /// Inactive destination bytes retain source.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> mask_vpermb(
    simd<std::uint8_t, 16, Arch> source,
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> indices,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi_constant::permute<false>(
        indices, value, simd<std::uint8_t, 16, Arch>{}, source, mask.to_bitset());
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi::mask_vpermb<Arch>(
          source.to_native(), mask.to_bitset(), indices.to_native(), value.to_native()));
    }
  }

  /// Inactive destination bytes become zero.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> maskz_vpermb(
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> indices,
    simd<std::uint8_t, 16, Arch> value) noexcept {
    if consteval {
      return detail::x86_vbmi_constant::permute<false>(
        indices, value, simd<std::uint8_t, 16, Arch>{}, simd<std::uint8_t, 16, Arch>{}, mask.to_bitset());
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi::maskz_vpermb<Arch>(
          mask.to_bitset(), indices.to_native(), value.to_native()));
    }
  }

  /// Permute bytes from two tables; the table index spans both complete vectors.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> vpermt2b(
    simd<std::uint8_t, 16, Arch> a,
    simd<std::uint8_t, 16, Arch> indices,
    simd<std::uint8_t, 16, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi_constant::permute<true>(
        indices, a, b, simd<std::uint8_t, 16, Arch>{}, ~std::uint64_t{0});
    } else {
      return simd<std::uint8_t, 16, Arch>::from_native(
        detail::x86_vbmi::vpermt2b<Arch>(
          a.to_native(), indices.to_native(), b.to_native()));
    }
  }

  /// Inactive destination bytes retain the first table a.
  template<isa<x86> Arch>
    requires(Arch.has(x86_feature::avx512f) &&
      Arch.has(x86_feature::avx512bw) &&
      Arch.has(x86_feature::avx512vbmi) &&
      Arch.has(x86_feature::avx512vl))
  native_nodiscard native_inline native_const native_target("avx512f,avx512bw,avx512vbmi,avx512vl")
  constexpr simd<std::uint8_t, 16, Arch> mask_vpermt2b(
    simd<std::uint8_t, 16, Arch> a,
    predicate<16, Arch> mask,
    simd<std::uint8_t, 16, Arch> indices,
    simd<std::uint8_t, 16, Arch> b) noexcept {
    if consteval {
      return detail::x86_vbmi_constant::permute<true>(
