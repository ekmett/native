// sollya tests/transcendentals/exp.sollya
prec = 256!;
display = hexadecimal!;
// Extrema of the binary32 split-ln2 reduction, including rounding transitions.
I = [-0x1.62e5d2p-2;0x1.62e52ep-2];
// Fix exp(0) to one. Degree six also rounds its linear coefficient to one.
for d from 1 to 6 do {
  if d == 6 then { objective = absolute; }
  else { objective = relative; };
  basis = [||];
  for i from 1 to d do { basis = basis :. i; };
  p = fpminimax(exp(x), basis, [|single...|], I, objective, 1);
  print("degree", d, p);
  // Real coefficient polynomial estimates, not rounded-operation bounds.
  print("absolute error estimate", dirtyinfnorm(p-exp(x), I));
  print("relative error estimate", dirtyinfnorm(p/exp(x)-1, I));
};
// The degree-seven coefficient words are retained as an explicit alternative.
p = horner(1+x+x^2*(0x1.0000005c8dd89p-1+x*(0x1.555555c673724p-3+
    x*(0x1.5554649b7487fp-5+x*(0x1.11105b3161a6fp-7+
    x*(0x1.6da756e670ea6p-10+x*0x1.a1d714d7b1510dp-13))))));
q = 0;
for i from 0 to 7 do { q = q + round(coeff(p,i),single,RN)*x^i; };
p = horner(q);
print("degree 7",p);
print("relative error estimate",dirtyinfnorm(p/exp(x)-1,I));
quit;
