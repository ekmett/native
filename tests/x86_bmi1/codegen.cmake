execute_process(COMMAND "${OBJDUMP}" --file-headers "${OBJECT}"
  RESULT_VARIABLE status OUTPUT_VARIABLE headers ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "objdump headers failed: ${errors}")
endif()
set(prefix "")
if(headers MATCHES "file format mach-o")
  set(prefix "_")
endif()
file(WRITE "${OUTPUT}" "")
foreach(operation IN ITEMS andn bextr bextr_controls blsi blsmsk blsr tzcnt)
  set(widths 32 64)
  if(operation STREQUAL "tzcnt")
    list(PREPEND widths 16)
  endif()
  string(REPLACE "_controls" "" opcode "${operation}")
  foreach(width IN LISTS widths)
    set(symbol "${prefix}probe_${operation}${width}")
    execute_process(COMMAND "${OBJDUMP}" -d --no-show-raw-insn --x86-asm-syntax=intel
      "--disassemble-symbols=${symbol}" "${OBJECT}"
      RESULT_VARIABLE status OUTPUT_VARIABLE assembly ERROR_VARIABLE errors)
    file(APPEND "${OUTPUT}" "${assembly}\n${errors}")
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "objdump failed: ${errors}")
    endif()
    string(REGEX MATCHALL "[0-9a-f]+ <[^>]+>:" symbols "${assembly}")
    list(LENGTH symbols symbol_count)
    if(NOT symbol_count EQUAL 1 OR NOT assembly MATCHES "<${symbol}>:")
      message(FATAL_ERROR "Missing isolated body for ${symbol}: ${assembly}")
    endif()
    string(REGEX MATCHALL "[ \t]${opcode}[ \t]" instructions "${assembly}")
    list(LENGTH instructions count)
    if(NOT count EQUAL 1 OR NOT assembly MATCHES "[ \t]ret[q]?[ \t\r\n]")
      message(FATAL_ERROR "Expected one ${opcode} and a return in ${symbol}: ${assembly}")
    endif()
    if(assembly MATCHES "[ \t](call[a-z]*|j[a-z]+|loop[a-z]*|v[a-z0-9]+)[ \t]|[xyz]mm[0-9]+|<unknown>")
      message(FATAL_ERROR "Unexpected control transfer or vector requirement in ${symbol}: ${assembly}")
    endif()
    # LLVM may lower tzcnt(uint16_t) to OR bit 16 followed by 32-bit TZCNT.
    # The runtime suite exhausts all 16-bit values, including zero => 16.
    message(STATUS "${symbol}: one ${opcode}, no helper call or AVX instructions")
  endforeach()
endforeach()
