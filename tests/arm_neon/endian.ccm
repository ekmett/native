module;
#include <native/isa_import.h>
#include <native/arm/neon_constant.h>
#include <native/arm/neon.h>
#include <native/targets.h>
export module native_test.arm.neon.endian;
export import native.arm.features;
export import native.simd;
// Exercise the real public constraints with the big-endian configuration.
// Storage and runtime helpers keep the host ABI; no BE execution is claimed.
#pragma push_macro("__BYTE_ORDER__")
#undef __BYTE_ORDER__
#define __BYTE_ORDER__ __ORDER_BIG_ENDIAN__
#include "native/arm/neon_body.h"
#pragma pop_macro("__BYTE_ORDER__")
