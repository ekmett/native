@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/simdHeaderTargets.cmake")
set(simd_headers_FOUND TRUE)
if(NOT simd_FIND_COMPONENTS OR "simd" IN_LIST simd_FIND_COMPONENTS)
  if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/simdHostTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/simdHostTargets.cmake")
    if(NOT TARGET simd::common)
      add_library(simd::common ALIAS simd::minimal)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/simdProfile.cmake")
    # CMake does not export source properties. Reapply the provider's ISA
    # in the package directory where its synthetic BMI targets are created.
    block()
      get_target_property(profiles simd::simd SIMD_OMNIBUS_PROFILES)
      set(omnibus_options)
      foreach(profile IN LISTS profiles)
        string(TOLOWER "${profile}" lower)
        simd_profile_options("${profile}" options)
        get_target_property(module_sources simd::${lower} CXX_MODULE_SET_cxx_modules)
        set_source_files_properties(${module_sources} PROPERTIES COMPILE_OPTIONS "${options}")
        list(APPEND omnibus_options ${options})
      endforeach()
      get_target_property(omnibus_source simd::simd CXX_MODULE_SET_cxx_modules)
      set_source_files_properties(${omnibus_source} PROPERTIES COMPILE_OPTIONS "${omnibus_options}")
    endblock()
    set(simd_simd_FOUND TRUE)
  else()
    set(simd_simd_FOUND FALSE)
    if(NOT simd_FIND_COMPONENTS)
      set(simd_FOUND FALSE)
      set(simd_NOT_FOUND_MESSAGE "This simd package contains headers only; request COMPONENTS headers.")
    endif()
  endif()
endif()
check_required_components(simd)
